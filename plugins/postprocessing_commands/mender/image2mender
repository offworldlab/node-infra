set -o errexit
set -o pipefail
set -o nounset

print_usage()
{
    cat <<EOF
Convert a full disk image into a mender update artifact.

Required arguments:
 -i IMAGE, --input=IMAGE                   : Partition image file that shall get converted into a mender update artifact.
 -o ARTIFACT, --output=ARTIFACT            : Name of the resulting mender update artifact.
 -a ARTIFACT_NAME, --artifact=ARTIFACT_NAME: Mender artifact name.
 -t DEVICE_TYPE, --type=DEVICE_TYPE        : The type of device supported by the update.
 -b BOOTLOADER, --bootloader=BOOTLOADER    : The selected bootloader ("u-boot" or "raspberry-pi").
Optional arguments:
 -h, --help                                : Print help text.
 --log=LEVEL                               : Use --log=DEBUG to trace all commands.
 --software-version=VERSION                : Software version for provides metadata.
 --software-name=NAME                      : Software name for provides metadata.
EOF
}

print_error()
{
    local MESSAGE="${1}"
    >&2 echo -e "\033[91mError: ${MESSAGE}\033[0m"
}

print_error_and_exit()
{
    local MESSAGE="${1}"
    print_error "${MESSAGE}"
    exit 1
}

unexpected_exit()
{
    print_error "Going to clean up after abnormal script termination."
    rm -f "${MENDER_ARTIFACT}"
    trap - EXIT
    print_error_and_exit "Abnormal script termination."
}

if ! options=$(getopt -o hi:o:a:t:b: -l help,log:,input:,output:,artifact:,type:,bootloader:,software-version:,software-name: -- "$@")
then
    print_usage
    print_error_and_exit "Invalid option."
fi
eval set -- "$options"

SCRIPTDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INPUT_IMAGE=""
MENDER_ARTIFACT=""
ARTIFACT_NAME=""
DEVICE_TYPE=""
LOG_LEVEL="INFO"
BOOTLOADER=""
SOFTWARE_VERSION=""
SOFTWARE_NAME=""

while true
do
    case "${1}" in
        -h|--help)              print_usage && exit 0;;
        -i|--input)             INPUT_IMAGE="${2}"; shift 2;;
        -o|--output)            MENDER_ARTIFACT="${2}"; shift 2;;
        -a|--artifact)          ARTIFACT_NAME="${2}"; shift 2;;
        -t|--type)              DEVICE_TYPE="${2}"; shift 2;;
        -b|--bootloader)        BOOTLOADER="${2}"; shift 2;;
        --log)                  LOG_LEVEL="${2}"; shift 2;;
        --software-version)     SOFTWARE_VERSION="${2}"; shift 2;;
        --software-name)        SOFTWARE_NAME="${2}"; shift 2;;
        *)                      break ;;
    esac
done

if [ "${LOG_LEVEL}" == "DEBUG" ]; then
    set -x
fi

if [ -z "${INPUT_IMAGE}" ]
then
    print_usage
    print_error_and_exit "Missing input image parameter."
fi

if [ -z "${MENDER_ARTIFACT}" ]
then
    print_usage
    print_error_and_exit "Missing output artifact parameter."
fi

if [ -z "${DEVICE_TYPE}" ]
then
    print_usage
    print_error_and_exit "Missing device type parameter."
fi

if [ -z "${BOOTLOADER}" ]
then
    print_usage
    print_error_and_exit "Missing bootloader parameter."
fi

if ! which mender-artifact > /dev/null
then
    print_error "Missing mender-artifact executable. Mender update artifact will not be built."
    # Ignore this error for now since the update image might not be needed for every use case.
    echo "Mender update artifact not built due to missing mender-artifact executable." >> "${MENDER_ARTIFACT}"
    exit 0
fi

if [ "${DEVICE_TYPE}" == "pi2-armhf" ]
then
    COMPATIBLE_DEVICE=( "--device-type" "rpi-armhf" )
elif [ "${DEVICE_TYPE}" == "pi3-armhf" ]
then
    COMPATIBLE_DEVICE=( "--device-type" "rpi-armhf" )
elif [ "${DEVICE_TYPE}" == "pi3-arm64" ]
then
    COMPATIBLE_DEVICE=( "--device-type" "rpi-arm64" )
else
    COMPATIBLE_DEVICE=()
fi

INPUT_OPTION="--file"
MENDER_ARTIFACT_VERSION=$(mender-artifact --version)
MENDER_ARTIFACT_MAJOR_VERSION=$(echo "${MENDER_ARTIFACT_VERSION}" | cut -d' ' -f 3 | cut -d'.' -f 1)

if [[ ${MENDER_ARTIFACT_MAJOR_VERSION} -eq 2 ]]
then
    INPUT_OPTION="--update"
fi

# Special treatment for the Debian buster mender-artifact package:
if [[ ${MENDER_ARTIFACT_VERSION} == *"really2"* ]]
then
    INPUT_OPTION="--update"
fi

BOOTPARTITION_SETUP_SCRIPT=()
if [ "${BOOTLOADER}" == "raspberry-pi" ]
then
    BOOTPARTITION_SETUP_SCRIPT=( "--script" "${SCRIPTDIR}/ArtifactInstall_Enter_50_BootpartitionSetup" )
fi

# Build software metadata flags
SOFTWARE_FLAGS=()
if [ -n "${SOFTWARE_VERSION}" ]; then
    SOFTWARE_FLAGS+=( "--software-version" "${SOFTWARE_VERSION}" )
fi
if [ -n "${SOFTWARE_NAME}" ]; then
    SOFTWARE_FLAGS+=( "--software-name" "${SOFTWARE_NAME}" )
fi

# --- OTA rootfs fixup: re-enable Mender services before packaging ---
#
# The ansible build (main.yml) ships the .img with Mender systemd services
# disabled and a cloud-services-disabled flag file present. This is correct
# for fresh SD card flashes — the user must explicitly consent to cloud
# services via retina-gui before Mender phones home.
#
# However, the .mender artifact (used for OTA rootfs updates) must have
# services ENABLED. Reasoning:
#   1. If an OTA is being deployed, Mender is already running and the user
#      has already consented to cloud services.
#   2. After reboot into the new rootfs, mender-updated must start so it
#      can run ArtifactVerifyReboot and complete the commit. If it doesn't
#      start, the update hangs and eventually rolls back.
#
# Since image2mender operates on the _rootfs.ext4 partition image (separate
# from the .img full disk image), modifications here only affect the OTA
# artifact — the .img remains untouched with services disabled.
#
# We mount the partition image, restore the systemd symlinks and remove the
# retina-gui flag, then unmount before mender-artifact packages it.

OTA_MNT=$(mktemp -d -t ota-rootfs-XXXXXXXX --tmpdir=/tmp)
mount -o loop "${INPUT_IMAGE}" "${OTA_MNT}"

# Restore systemd service symlinks (removed by ansible main.yml lines 209-216)
SYSTEMD_WANTS="${OTA_MNT}/etc/systemd/system/multi-user.target.wants"
mkdir -p "${SYSTEMD_WANTS}"
for svc in mender-authd.service mender-updated.service mender-connect.service; do
    ln -sf "/lib/systemd/system/${svc}" "${SYSTEMD_WANTS}/${svc}"
done

# Remove the cloud-services-disabled flag so retina-gui sees services as
# enabled on boot and doesn't try to disable them again.
rm -f "${OTA_MNT}/data/retina-gui/cloud-services-disabled"

umount "${OTA_MNT}"
rmdir "${OTA_MNT}"

mender-artifact write rootfs-image --device-type "${DEVICE_TYPE}" "${COMPATIBLE_DEVICE[@]}" \
    --artifact-name "${ARTIFACT_NAME}" ${INPUT_OPTION} "${INPUT_IMAGE}" --version 3 \
    --script "${SCRIPTDIR}/ArtifactInstall_Leave_50_ConfigurationBackup" \
    --script "${SCRIPTDIR}/ArtifactReboot_Leave_50_ConfigurationRestore" \
    --script "${SCRIPTDIR}/ArtifactInstall_Enter_00_retina_state" \
    --script "${SCRIPTDIR}/ArtifactCommit_Leave_00_retina_state" \
    --script "${SCRIPTDIR}/ArtifactFailure_Enter_00_retina_state" \
    "${BOOTPARTITION_SETUP_SCRIPT[@]}" \
    "${SOFTWARE_FLAGS[@]}" \
    --output-path "${MENDER_ARTIFACT}"

trap - EXIT